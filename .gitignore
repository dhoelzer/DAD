.DS_Store
# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle
/vendor/bundle

# Gemfile.lock and db/schema.rb are deliberately tracked: they are what make
# builds and test databases reproducible. Do not ignore them.
# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-wal
/db/*.sqlite3-shm

# Precompiled assets. Never tracked historically; the assets CI job now runs
# assets:precompile, so builds would otherwise show up as untracked noise.
/public/assets

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp
/Logs/LogsToProcess/sample*

# Partition archives written by retention before it drops a month (see
# EventPartitionBackup). Raw log lines, never committed.
/offline_storage

# Cargo build output for the syslog collector. provision.sh builds into the
# checkout, so this lands here on a provisioned host; the Docker build writes it
# in its own stage instead. Cargo.lock IS committed -- the crate is a binary with
# no dependencies, so the lockfile is the record that there are none.
/syslog_collector/target

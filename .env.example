# Compose reads ./.env automatically. Copy this to .env and edit; .env is
# git-ignored, so a real password never reaches the checkout.
#
# Every value has a working default, so an empty .env changes nothing. They exist
# for the cases where the default collides with the host:
#
#   - the host already runs a syslog daemon on UDP 514
#   - the default admin password is not acceptable
#   - something real sends syslog from the Docker bridge subnet
#
# Production does not read this file. Its secrets live in /etc/DAD/environment,
# sourced by every systemd unit (see systemd/README.md).

# Published UDP port for the collector, and the address every container's syslog
# log driver sends to. They are the same interpolation on purpose: setting one
# without the other would publish the port but ship logs into a black hole.
# Move this if the host already holds 514.
DAD_SYSLOG_PORT=514

# Seeds the initial admin account on an empty database (db/seeds.rb raises rather
# than inventing a well-known account, so without this the stack comes up with
# zero users and the login form can never succeed). Development convenience only.
DAD_ADMIN_PASSWORD=dad_dev_password

# Whether the importer may name a System after a container's log tag when the line
# arrives from this host's own bridge gateway. Default auto, which is what makes
# each container show up as its own host instead of every one of them collapsing
# onto the gateway address. Set none if something real also sends syslog from the
# bridge subnet -- the Docker host itself, or a VM behind the same bridge -- and
# you would rather its events stayed filed under that address.
DAD_SYSLOG_SELF_HOST=auto

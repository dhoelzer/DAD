[Unit]
Description=DAD syslog collector (UDP/514 -> Logs/LogStaging)
Documentation=file:///var/DAD/RECOMMENDATIONS.md
After=network.target
Before=dad-importer.service
# In [Unit], not [Service]: systemd >= 229 moved rate-limit keys here and
# now rejects them under [Service]. 0 means never give up restarting --
# otherwise five fast failures leave the service permanently down, which is
# the same failure mode as the old `&`.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/var/DAD
# No EnvironmentFile: syslog.pl holds no database credentials and needs none.
# The only variable it reads is DAD_SYSLOG_DEBUG, which is opt-in -- set it in a
# drop-in (systemctl edit dad-syslog) when you want received messages echoed to
# the journal.
ExecStart=/usr/bin/perl /var/DAD/syslog.pl
Restart=always
RestartSec=5
# Port 514 is privileged. Rather than run as root, take only the capability
# needed to bind a low port. If the box runs something else on 514, override
# ExecStart in a drop-in rather than dropping back to root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
User=www-data
Group=www-data
SyslogIdentifier=dad-syslog
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

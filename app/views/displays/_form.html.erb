<%= form_for(@display) do |f| %>
  <% if @display.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@display.errors.count, "error") %> prohibited this display from being saved:</h2>

      <ul>
      <% @display.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :key %><br>
    <%= f.text_field :key %>
  </div>
  <div class="field">
    <%= f.label :display_script, "Display rule" %><br>
    <%= f.text_area :display_script, :rows => 6 %>
    <p class="help">Directives, one per line: <code>fields 1,2,5</code>,
       <code>regex (\w+@\S+)</code>, <code>label 3=proto:</code>,
       <code>join ,</code> (the separator may not be a plain space; that is the
       default). <code>#</code> starts a comment. Ruby is not
       accepted here.</p>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

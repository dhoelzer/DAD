<%= form_for(@exclusion) do |f| %>
  <%= render 'shared/error_explanation', record: @exclusion %>

  <div class="field">
    <%= f.label :pattern %><br>
    <%= f.text_field :pattern %>
  </div>
  <div class="field">
    <%= f.label :user %><br>
    <%= @exclusion.user.username %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

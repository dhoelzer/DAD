<%= form_for(@role) do |f| %>
  <%= render 'shared/error_explanation', record: @role %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_field :description %>
  </div>
	<div>
		<strong>Rights:</strong>
		<ul>
		<% @role.rights.each do |right| %>
			<li><%= "#{right.name} -> #{right.description}"%>
		<% end %>
		</ul>
	</div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

<%= form_for(@search) do |f| %>
  <%= render 'shared/error_explanation', record: @search %>

  <div class="field">
    <%= f.label :string %><br>
    <%= f.text_area :string %>
  </div>
  <div class="field">
    <%= f.label :user_id %><br>
    <%= f.number_field :user_id %>
  </div>
  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :short_description %><br>
    <%= f.text_field :short_description %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

<h1>Editing <%= @polling_priority.name %></h1>

<%= form_for(@polling_priority) do |f| %>
  <%= render 'shared/error_explanation', record: @polling_priority %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :rank %><br>
    <%= f.number_field :rank %>
  </div>
  <div class="field">
    <%= f.label :max_interval_secs, 'At least every (seconds)' %><br>
    <%= f.number_field :max_interval_secs %>
    <br><span class="hint">The guarantee. A host on this priority is polled at
      least this often, no matter how quiet it gets.</span>
  </div>
  <div class="field">
    <%= f.label :min_interval_secs, 'Never more often than (seconds)' %><br>
    <%= f.number_field :min_interval_secs %>
    <br><span class="hint">The floor on how hard DAD works at one host.</span>
  </div>
  <div class="field">
    <%= f.label :enabled %><br>
    <%= f.check_box :enabled %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

<%= link_to 'Back', polling_priorities_path %>

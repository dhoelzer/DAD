<div id="turbokiller" data-no-turbolink>
<%= form_for(@job) do |f| %>
  <%= render 'shared/error_explanation', record: @job %>

  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :script, "Operation" %><br>
    <%= f.select :script, JobHandler.names.map { |n| [n.humanize, n] },
          :include_blank => "Select an operation" %>
    <p class="help">Jobs run a fixed set of operations defined in the codebase;
       arbitrary scripts are no longer supported.</p>
  </div>
  <div class="field">
    <%= f.label :last_event_id %><br>
    <%= f.number_field :last_event_id %>
  </div>
  <div class="field">
    <%= f.label :last_run %><br>
    <%= f.datetime_select :last_run %>
  </div>
  <div class="field">
    <%= f.label :next_run %><br>
    <%= f.datetime_select :next_run %>
  </div>
  <div class="field">
    <%= f.label :frequency %><br>
    <%= f.number_field :frequency %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
</div>

<%= form_for(@system) do |f| %>
  <%= render 'shared/error_explanation', record: @system %>

  <div class="field">
    <%= f.label :address %><br>
    <%= f.text_field :address %>
  </div>
  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :administrator %><br>
    <%= f.text_field :administrator %>
  </div>
  <div class="field">
    <%= f.label :contact_email %><br>
    <%= f.text_field :contact_email %>
  </div>
  <div class="field">
	<%= f.label :monitor %><br>
	<%= f.check_box :monitor %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

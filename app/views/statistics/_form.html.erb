<%= form_for(@statistic) do |f| %>
  <%= render 'shared/error_explanation', record: @statistic %>

  <div class="field">
    <%= f.label :type_id %><br>
    <%= f.number_field :type_id %>
  </div>
  <div class="field">
    <%= f.label :timestamp %><br>
    <%= f.datetime_select :timestamp %>
  </div>
  <div class="field">
    <%= f.label :system_id %><br>
    <%= f.number_field :system_id %>
  </div>
  <div class="field">
    <%= f.label :service_id %><br>
    <%= f.number_field :service_id %>
  </div>
  <div class="field">
    <%= f.label :stat %><br>
    <%= f.text_field :stat %>
  </div>
  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>

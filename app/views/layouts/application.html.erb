<!DOCTYPE html>
<html lang="en">
<head>
  <title>DAD Log Aggregation and Monitoring</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= stylesheet_link_tag    "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%= csrf_meta_tags %>
</head>
<body>
	<div id="navbar">
		<ul>
			<% nav_flat_models.each do |model| %>
			<li class="<%= is_active(model) %>"><%= link_to nav_label(model), model.constantize %></li>
			<% end %>
			<% if nav_windows_models.any? %>
			<li class="nav-group-item <%= nav_group_class(nav_windows_models) %>">
			<details class="nav-group">
			<summary>Windows</summary>
			<ul class="submenu">
			<% nav_windows_models.each do |model| %>
			<li class="<%= is_active(model) %>"><%= link_to nav_label(model), model.constantize %></li>
			<% end %>
			</ul>
			</details>
			</li>
			<% end %>
			<li id="active_user"><%= link_to @current_user.nil? ? "No User" : @current_user.username, "#" %></li>
			<% if @current_user %>
				<li id="logoff"><%= link_to "Logoff", logoff_users_path %>
			<% end %>
		</ul>
	</div>
<p id="notice"><%= notice %></p>	
<%= yield %>
</body>
</html>

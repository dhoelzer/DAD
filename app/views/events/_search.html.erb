<%= form_tag :search_events, { method: 'get', remote: true} do %>
<%= text_field_tag 'search_terms', (@previous_search.nil? ? "" : "#{@previous_search}"), placeholder: "Search", id: "search_terms"%>
<% timeframes = [
	["10 minutes", 600],
	["30 minutes", 1800],
	["1 hour", 3600],
	["6 hours", 21600],
	["12 hours", 43200],
	["1 day", 86400],
	["1 week", 604800],
	["All records", 50000000]
	] %>
<%# @timeframe, not @timeframes: the controller sets the singular. Reading the
    plural always yielded nil, so the select snapped back to "10 minutes" after
    every search whatever the operator had picked. %>
<%= select_tag 'timeframe', options_for_select(timeframes, (@timeframe.nil? ? "600" : @timeframe))%>
<% num_results = [50, 100, 200, 500, 1000, 5000, 10000, 50000] %>
<%= select_tag 'numresults', options_for_select(num_results, (@num_results.nil? ? 100 : @num_results)) %>
<%= check_box "timesearch_enabled", "enabled" %> Timeframe Search?
Start: <%= datetime_select("lefttime", "start") %> End: <%= datetime_select("righttime", "end") %>
<%= submit_tag "Search", id: "searchload" %>
<% end %>

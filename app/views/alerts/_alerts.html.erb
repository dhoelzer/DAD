<div id="alerts">
        <div id="alerts-header">
      <div class='alert-time'>Generated</div>
      <div class='alert-system'>System</div>
      <div class='alert-service'>Service</div>
          <div class='alert-desc'>Description</div>
          <div class='alert-ack'></div>
          <div class='alert-comments'>Comments?</div>
        </div>

    <% @alerts.each do |alert| %>
      <div class='criticality-<%=alert.criticality%>'>
                <div class='alert-time'><%= timestamp_helper(alert.generated) %>&nbsp;</div>
        <div class='alert-system'><%= alert.system.display_name unless alert.system.nil? %>&nbsp;</div>
        <div class='alert-service'><%= alert.service.name unless alert.service.nil? %>&nbsp;</div>
        <div class='alert-desc'><%= link_to alert.short_description, alert %>&nbsp;</div>
        <div class='alert-ack'><%= button_to 'Ack', acknowledge_alert_path(alert), remote: true, method: :post, class: 'ack-button' %></div>
                <div class='alert-comments'><%= alert.comments.count < 1 ? "" : "*"%>&nbsp;</div>
      </div>
    <% end %>
</div>

# Reproducible dev/test image. The base tag is pinned to a patch release:
# this Rails line predates Ruby 3.0's keyword-argument separation and does not
# boot there, so an unpinned `ruby:2` tag silently breaks the app on a future
# minor release.
FROM ruby:2.7.8

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libsqlite3-dev \
      libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Bundler version is pinned by the "BUNDLED WITH" section of Gemfile.lock.
# Bundler 2.4.x is the last line that still runs on Ruby 2.7; 2.5+ requires 3.x.
gem install bundler -v 2.4.22 --no-document

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=production

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install --frozen

COPY . .

EXPOSE 3000
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]

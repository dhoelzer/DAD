# Reproducible dev/test image. The base tag is pinned to a patch release: an
# unpinned `ruby:3` tag silently breaks the app on a future minor release.
# Ruby 3.3 satisfies Rails 8.1 (which needs >= 3.2); the app moved off 2.7
# because nokogiri/sqlite3 and the json default gem no longer support it.
FROM ruby:3.3.8

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libsqlite3-dev \
      libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Bundler version is pinned by the "BUNDLED WITH" section of Gemfile.lock.
gem install bundler -v 2.6.7 --no-document

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT=production

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install --frozen

COPY . .

EXPOSE 3000
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0"]

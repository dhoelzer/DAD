#!/usr/bin/env bash
#
# Rotates the production SECRET_KEY_BASE in place.
#
# Why this exists: provision.sh generates the key only when /etc/DAD/environment
# does not already exist, so a host that has been provisioned once has no
# supported way to change it. That gap is why RECOMMENDATIONS 1.1 could be
# recorded as "rotated" while a deployed instance kept using the burned key --
# there was nothing to run.
#
# Rotation is cheap here, and it is worth saying why, because the usual
# assumption about changing a signing key does not hold:
#
#   Sessions are rows in the database, not cookie payloads. gatekeeper looks the
#   token up with Session.find_by(session_hash: cookies[:sessionID]), and the
#   token is a SecureRandom.hex(32) written as a plain cookie value. It is not
#   signed by secret_key_base, so rotating the key does not invalidate a single
#   session and does not log anyone out.
#
#   What does get invalidated is the Rails cookie_store session
#   (_Events_session, config/initializers/session_store.rb), which carries the
#   CSRF token and flash. Those are re-minted on the next request, so the worst
#   case is that an in-flight form post needs to be resubmitted.
#
# Writes both env files provision.sh maintains, so they cannot drift, and keeps
# every other value (database password, admin password) untouched.
#
# Run as root, or with sudo. The new key is never echoed to the terminal.

set -euo pipefail

ENV_FILE=/etc/DAD/environment
SYSTEMD_ENV_FILE=/etc/DAD/environment.d/dad.conf

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root (this rewrites root-owned files under /etc/DAD)." >&2
  exit 1
fi

if ! [ -f "$ENV_FILE" ]; then
  echo "No $ENV_FILE. This host has not been provisioned; run provision.sh instead." >&2
  exit 1
fi

# Refuse to rotate a key that is not actually in use, rather than silently
# writing a value nothing reads.
if ! grep -q '^export SECRET_KEY_BASE=' "$ENV_FILE"; then
  echo "$ENV_FILE has no SECRET_KEY_BASE line to rotate." >&2
  exit 1
fi

NEW_KEY=$(openssl rand -hex 64)

# Backup before touching anything, and 0600 from the moment of creation: the
# file holds the database password, and a plain cp would land it world-readable
# under whatever umask the caller has.
BACKUP="$ENV_FILE.pre-rotation.$(date -u +%Y%m%dT%H%M%SZ)"
umask 077
install -m 600 "$ENV_FILE" "$BACKUP"

# Replace only the SECRET_KEY_BASE line. Written to a temp file and moved into
# place with install -m 600 rather than sed -i, so the replacement cannot be
# observed half-written and so the mode is set explicitly rather than inherited.
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT
sed "s|^export SECRET_KEY_BASE=.*|export SECRET_KEY_BASE=$NEW_KEY|" "$ENV_FILE" > "$TMP"
install -m 600 "$TMP" "$ENV_FILE"

# The systemd copy is regenerated from the file just written, the same way
# provision.sh does it, so the two cannot disagree. systemd has no shell and
# cannot source the `export KEY=value` form.
if [ -f "$SYSTEMD_ENV_FILE" ]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  TMP2=$(mktemp)
  trap 'rm -f "$TMP" "$TMP2"' EXIT
  sed "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$SECRET_KEY_BASE|" "$SYSTEMD_ENV_FILE" > "$TMP2"
  install -m 600 "$TMP2" "$SYSTEMD_ENV_FILE"
fi

# Passenger holds the old value in the already-booted Ruby process; the key is
# read at boot, so nothing changes until the app restarts.
if command -v systemctl >/dev/null 2>&1; then
  systemctl restart apache2 2>/dev/null || true
  systemctl restart dad-syslog dad-importer dad-scheduler 2>/dev/null || true
else
  echo "No systemctl; restart apache2 and the dad-* services by hand or the app" >&2
  echo "will keep signing with the old key." >&2
fi

echo "Rotated SECRET_KEY_BASE. Previous env file kept at $BACKUP"
echo "Sessions were not invalidated: they are database rows, not signed cookies."
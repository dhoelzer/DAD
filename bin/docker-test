#!/usr/bin/env bash
#
# Run the test suite against the Dockerized PostgreSQL, which is the engine
# production runs.
#
# This is how the suite runs, full stop. SQLite was dropped as the test engine:
# Event.insertStatement once emitted SQLite `?` placeholders through exec_query,
# Postgres rejected them outright, and production could not insert a single event
# while every SQLite job stayed green (RECOMMENDATIONS 3.2). events and
# events_words are partitioned on Postgres and are not partitionable at all on
# SQLite, so a SQLite suite never exercises the shape production queries, and the
# composite covering index on events_words is Postgres-only.
#
# `bundle exec rake test` still works against a local Postgres cluster once
# config/database.yml points at one, but this script is the zero-configuration
# path: it brings up its own db container and runs the schema-shape and
# INVALID-index assertions CI makes.
#
# --build is not optional. `docker compose run` does not rebuild the image, so
# without it this runs whatever code was copied at the last build and reports on
# code you did not just write.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! docker info >/dev/null 2>&1; then
  echo "bin/docker-test: the Docker daemon is not reachable." >&2
  echo "  Start it, or point config/database.yml (or DATABASE_URL) at a local" >&2
  echo "  Postgres cluster and run: bundle exec rake test" >&2
  exit 1
fi

# Extra arguments replace the container command rather than appending to it, so
# you can drop into the test container or run one file:
#   bin/docker-test bundle exec rails test test/models/event_test.rb
#   bin/docker-test bash
exec docker compose --profile test run --build --rm test "$@"
